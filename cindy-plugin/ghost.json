{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.139",
  "id": "knowledge-magazine",
  "name": "知识杂志",
  "description": "阅读「知识杂志」：今日变化、本周脉络、主题与往期，证据可回溯；与桌面同批。",
  "whenToUse": "阅读知识杂志（今日/本周/主题/往期）、核对判断与出处、查看杂志覆盖缺口与最近出刊状态时使用。",
  "version": "1.2.0",
  "kind": "chip",
  "entry": "main.js",
  "tools": [
    {
      "name": "get_magazine",
      "description": "读取最新一期知识杂志的摘要：材料日与批次、今日总判断、主编精选（含来源链接）、本周主题与脉络、交叉核验清单、覆盖与缺口。数据与桌面 ~/Desktop/知识杂志 同一批次。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "get_archive",
      "description": "列出桌面杂志存档（今日/本周各期 HTML 文件与数据时点）。不打开文件，只返回清单。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "command": "knowledge-magazine",
  "launch": "on-demand",
  "mainView": {
    "title": "知识杂志",
    "icon": "calendar-days",
    "html": "main-view.html"
  },
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "on-demand",
    "idleTimeoutSeconds": 120
  },
  "settingsHtml": "settings.html",
  "settingsHeight": 300
}
